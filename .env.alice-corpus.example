# Extracted immutable Alice corpus root. Do not point public Alice at an unrestricted corpus directory.
ALICE_CORPUS_ROOT=/srv/alice-corpus/ALICE_CORPUS_MASTER_v1.0

# Required physical projection: public | internal | diligence | restricted-security | owner-private
ALICE_CORPUS_PROJECTION=internal

# selected verifies only files loaded by this process; full verifies every entry in SHA256SUMS.txt.
ALICE_CORPUS_VERIFY=selected

# Configured corpus failures stop runtime initialization when enabled.
ALICE_CORPUS_STRICT=1

# Enables read-only projected graph actions.
ALICE_CORPUS_GRAPH_ENABLED=1

# Additional explicit safeguard for the most sensitive projection.
ALICE_CORPUS_ALLOW_OWNER_PRIVATE=0
