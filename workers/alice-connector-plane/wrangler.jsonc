{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "036df6c823669b8fa2f66cf4c16eeb29",
  "name": "alice-connector-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "ALICE_STATE_OWNER_ID": "alice-owner-production",
    "ALICE_CONNECTOR_SESSION_ID": "alice-connectors-production",
    "ALICE_DISCORD_PRIVATE_DESTINATION_ID": "REPLACED_BY_PRODUCTION_DEPLOY",
    "ALICE_TELEGRAM_PRIVATE_DESTINATION_ID": "REPLACED_BY_PRODUCTION_DEPLOY"
  },
  "secrets": {
    "required": [
      "ALICE_CONNECTOR_SERVICE_TOKEN",
      "ALICE_STATE_PLANE_SERVICE_TOKEN",
      "ALICE_CONTROL_CONNECTOR_SERVICE_TOKEN",
      "DISCORD_API_TOKEN",
      "DISCORD_APPLICATION_ID",
      "TELEGRAM_BOT_TOKEN"
    ]
  },
  "services": [
    {
      "binding": "ALICE_STATE_PLANE",
      "service": "alice-state-plane"
    },
    {
      "binding": "ALICE_CONTROL",
      "service": "alice-production-control"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ALICE_CONNECTOR_OUTBOUND",
        "class_name": "AliceConnectorOutboundCoordination"
      }
    ]
  },
  "migrations": [
    {
      "tag": "alice-connector-plane-v1",
      "new_sqlite_classes": ["AliceConnectorOutboundCoordination"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
