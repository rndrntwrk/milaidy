{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "036df6c823669b8fa2f66cf4c16eeb29",
  "name": "alice-ai-gateway",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "upload_source_maps": true,
  "vars": {
    "ALICE_DEPLOYMENT_MANIFEST_SHA256": "pending",
    "ALICE_DEPLOYMENT_MANIFEST_B64": "pending"
  },
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "ALICE_CONTROL",
      "service": "alice-production-control"
    }
  ],
  "secrets": {
    "required": ["ALICE_RUNTIME_RELEASE_TOKEN_SHA256", "ALICE_AI_CONTROL_SERVICE_TOKEN"]
  },
  "version_metadata": {
    "binding": "ALICE_VERSION"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
