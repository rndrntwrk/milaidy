{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "036df6c823669b8fa2f66cf4c16eeb29",
  "name": "alice-access-gateway",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "alice.rndrntwrk.com/*",
      "zone_name": "rndrntwrk.com"
    }
  ],
  "vars": {
    "ALICE_ACCESS_ISSUER": "https://rndrntwrk.cloudflareaccess.com",
    "ALICE_ACCESS_AUDIENCE": "1f65441271f72eee92c371c42306885595ae71f950d2ed5aaa1ac354788410e4",
    "ALICE_OWNER_EMAIL_SHA256": "REPLACED_BY_PRODUCTION_DEPLOY",
    "ALICE_CLOUDFLARE_RUNTIME_IMAGE": "REPLACED_BY_PRODUCTION_DEPLOY",
    "ALICE_DEPLOYMENT_MANIFEST_SHA256": "pending",
    "ALICE_DEPLOYMENT_MANIFEST_B64": "pending"
  },
  "secrets": {
    "required": [
      "ALICE_ACCESS_PROXY_SECRET",
      "ALICE_ACCESS_CONTROL_SERVICE_TOKEN"
    ]
  },
  "services": [
    {
      "binding": "ALICE_CONTROL",
      "service": "alice-production-control"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ALICE_RUNTIME_CONTAINER",
        "class_name": "AliceRuntimeContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2-alice-runtime-container",
      "new_sqlite_classes": ["AliceRuntimeContainer"]
    }
  ],
  "containers": [
    {
      "name": "alice-production-runtime",
      "class_name": "AliceRuntimeContainer",
      "image": "registry.cloudflare.com/036df6c823669b8fa2f66cf4c16eeb29/alice-runtime:REPLACED_BY_PRODUCTION_DEPLOY",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "version_metadata": {
    "binding": "ALICE_VERSION"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
