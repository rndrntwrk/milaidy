{
  "schemaVersion": "alice.production-policy.v1",
  "policyId": "alice-production-core-2026-08-22",
  "authority": {
    "canonicalTaskState": "cloudflare-durable-objects",
    "ownerAuthentication": "cloudflare-access-exact-owner-jwt",
    "privilegedCapabilityGrant": "disabled-pending-device-bound-webauthn",
    "economicSigner": "renclave-external-only",
    "runtimeAuthority": "proposer-only"
  },
  "autonomousActions": [
    "research.read",
    "research.retrieve",
    "memory.read",
    "draft.create",
    "runtime.health"
  ],
  "capabilityActions": [
    "sandbox.execute",
    "coding.patch.sandbox"
  ],
  "disabledActions": [
    "social.post",
    "social.message",
    "production.deploy",
    "repository.merge",
    "trade.execute",
    "funds.withdraw",
    "funds.bridge",
    "economic.sign",
    "identity.admin",
    "issuer.admin",
    "stream.public",
    "risk.increase"
  ],
  "pauseScopes": [
    "all",
    "social",
    "trading",
    "stream",
    "coding",
    "model",
    "modal",
    "signer",
    "release"
  ],
  "modelRouting": {
    "cloudflareAiGateway": "alice-production",
    "dailySynchronousUnitCeiling": 100000,
    "gatewayCaching": "disabled",
    "gatewayPayloadLogging": "disabled",
    "models": [
      "workers-ai/@cf/openai/gpt-oss-20b",
      "workers-ai/@cf/openai/gpt-oss-120b",
      "@cf/baai/bge-m3"
    ]
  },
  "runtimeBoundaries": {
    "cloudflare": "durable-authority-workflows-queues-evidence-and-model-control",
    "modal": "zero-idle-bounded-proposer-runtime-only",
    "railway": "not-admitted-for-alice-core-v1",
    "stream": "installed-but-disabled",
    "social": "native owner conversations only; connector plane inert",
    "trading": "installed-but-disabled",
    "codingExecution": "installed-but-disabled",
    "signing": "not-present"
  },
  "nativeOwnerConversations": {
    "scope": "owner-directed private conversations",
    "discord": "disabled pending owner configuration and policy amendment",
    "operations": [
      "reply to incoming owner messages",
      "verify owner self-pairing"
    ],
    "controls": [
      "authenticated owner configuration",
      "native private chat allowlist before message and command handling",
      "owner-only pairing issuance and expiring single-use verification",
      "persistent canonical owner identity"
    ],
    "credentials": "encrypted Alice configuration loaded by the native runtime",
    "activation": "require verified configuration matching this owner, bot and private chat",
    "autonomousSocialOperations": "disabled",
    "connectorPlane": "inert",
    "platform": "telegram",
    "ownerBindingSha256": "sha256:f8b1566829c84cf5f91109d41177fa87ef28e1ab5b5fa0bf2a5642267fca05d5"
  }
}
