+  // Only explicit owner-pairing retention can alias another Telegram account.
+  // Read the durable link and verified identity before granting canonical access.
+  for (const ownerId of ownerIds) {
+    const relationships = await runtime.getRelationships({
+      entityIds: [ownerId as UUID],
+      tags: ["identity_link"],
+    });
+    for (const relationship of relationships) {
+      const metadata = relationship.metadata;
+      if (
+        relationship.targetEntityId !== ownerId ||
+        relationship.sourceEntityId === ownerId ||
+        !Array.isArray(relationship.tags) ||
+        !relationship.tags.includes("identity_link") ||
+        metadata?.status !== "confirmed" ||
+        metadata.source !== "owner_pairing" ||
+        metadata.connector !== "telegram"
+      ) continue;
+      const retained = await runtime.getEntityById(relationship.sourceEntityId);
+      const verifiedAt = connectorRecord(retained)?.ownerBindVerifiedAt;
+      if (
+        typeof verifiedAt === "number" &&
+        Number.isFinite(verifiedAt) &&
+        verifiedAt > 0 &&
+        telegramOwnerMatches(retained, telegramUserId)
+      ) return ownerId as UUID;
+    }
+  }
+
   // `getEntityById` throws on storage failure; a null owner here means the
