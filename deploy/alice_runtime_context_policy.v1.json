{
  "schemaVersion": "alice.runtime-root-policy.v1",
  "forbiddenPrefixes": [
    ".git",
    ".github"
  ],
  "forbiddenBasenames": [
    ".env",
    ".env.local",
    ".env.production",
    ".npmrc",
    ".pypirc"
  ],
  "maxFileBytes": 1073741824,
  "maxEntryCount": 2000000,
  "maxTotalFileBytes": 21474836480,
  "allowDanglingSymlinks": true
}
