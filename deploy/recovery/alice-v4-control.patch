diff --git a/workers/alice-production-control/test/authority.test.ts b/workers/alice-production-control/test/authority.test.ts
index d644ba4ff..026540d39 100644
--- a/workers/alice-production-control/test/authority.test.ts
+++ b/workers/alice-production-control/test/authority.test.ts
@@ -408,0 +409,21 @@ describe("Alice durable authority ledger", () => {
+  test("reads a paused v4 ledger during rollback only without WebAuthn state", () => {
+    const ledger = AuthorityLedger.create(binding, 100);
+    ledger.pause("all", 1_787_400_000_000, "deployment-controller:pause-only", "pause-all-0001");
+    const migrated = {
+      ...ledger.exportState(),
+      schemaVersion: "alice.authority-ledger.v4" as const,
+      webauthn: { credential: null, pending: null },
+    };
+    const restored = AuthorityLedger.restoreGlobal(migrated, 100);
+    expect(restored.snapshot().pausedScopes).toEqual(["all"]);
+    expect(restored.exportState()).toEqual(migrated);
+    expect(() => AuthorityLedger.restoreGlobal({
+      ...migrated,
+      webauthn: { credential: { id: "unexpected" }, pending: null },
+    } as unknown as AuthorityLedgerState, 100)).toThrow("AUTHORITY_STATE_INVALID");
+    expect(() => AuthorityLedger.restoreGlobal({
+      ...migrated,
+      capabilities: { unexpected: {} },
+    } as unknown as AuthorityLedgerState, 100)).toThrow("AUTHORITY_STATE_INVALID");
+  });
