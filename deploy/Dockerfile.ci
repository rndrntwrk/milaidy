# syntax=docker/dockerfile:1.7
# elizaOS Agent — CI Docker Image
# Pre-built artifacts come from GHA (bun install + tsdown + vite build done before docker)
ARG ESBUILD_VERSION=0.28.0
ARG APP_ENTRYPOINT=app.mjs
ARG APP_CMD_START=""
ARG APP_PORT=2138
ARG APP_API_BIND=127.0.0.1
ARG OCI_SOURCE=""
ARG OCI_TITLE="elizaOS Agent"
ARG OCI_DESCRIPTION="elizaOS agent runtime"
ARG OCI_LICENSES="MIT"
ARG VERSION=""
ARG VERSION_CLEAN=""
ARG REVISION=""
ARG ELIZA_REVISION=""

FROM oven/bun:1.3.14@sha256:50317d83cd5a5ae1d8b35b3379c69f57ce1a0dbf4def91f0965653d767851834 AS bun-runtime

FROM python:3.11.13-slim-bookworm@sha256:cec9aa7aa96eea4fa036e9b82be1e6b325f2e3707f462d885868df51ec0a4b47 AS python-runtime

FROM node:24.19.0-bookworm-slim@sha256:65932751ed4073ed02f5c04e494e4b2572a891b7dbea0568a863dc80341bf848 AS pruner
COPY --from=bun-runtime /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
COPY . .
RUN bun install --ignore-scripts --frozen-lockfile

# ===== Replace workspace symlinks with actual compiled packages =====
# Bun workspace symlinks break in Docker. Delete the symlinks entirely
# and replace with the actual package contents + CI-compiled dist/.
RUN set -x; \
    # @elizaos/core: delete symlink, copy package + compiled dist
    rm -rf node_modules/@elizaos/core; \
    mkdir -p node_modules/@elizaos/core; \
    cp eliza/packages/core/package.json node_modules/@elizaos/core/; \
    cp -a eliza/packages/core/dist node_modules/@elizaos/core/dist 2>/dev/null || true; \
    # NOTE: Do NOT copy src/ - tsx will prefer raw .ts over compiled dist/
    # cp -a eliza/packages/core/src node_modules/@elizaos/core/src 2>/dev/null || true; \
    ls node_modules/@elizaos/core/dist/node/index.node.js 2>/dev/null && echo "@elizaos/core dist OK" || echo "WARN: core dist/node missing"; \
    # @elizaos/agent: runtime compatibility alias for Milady's agent package.
    # Eliza runtime code imports @elizaos/agent/*, but Alice's deployment
    # expects those imports to resolve to the Milady fork.
    rm -rf node_modules/@elizaos/agent; \
    mkdir -p node_modules/@elizaos/agent; \
    cp packages/agent/package.json node_modules/@elizaos/agent/; \
    cp -a packages/agent/src node_modules/@elizaos/agent/src 2>/dev/null || true; \
    cp -a packages/agent/dist node_modules/@elizaos/agent/dist 2>/dev/null || true; \
    # Latest official app-manager imports these pure host services. Alice keeps
    # its agent implementation authoritative while overlaying the two missing
    # compatibility modules from the exact pinned Eliza source.
    cp eliza/packages/agent/src/services/app-manager-agents-list-guard.ts node_modules/@elizaos/agent/src/services/; \
    cp eliza/packages/agent/src/services/overlay-app-presence.ts node_modules/@elizaos/agent/src/services/; \
    ls node_modules/@elizaos/agent/src/api/config-env.ts 2>/dev/null && echo "@elizaos/agent Milady alias OK" || echo "WARN: agent Milady alias missing"; \
    # Product plugin resolution is dynamic. Materialize both Alice package
    # identities so Arcade and canonical Stream/Ads never depend on workspace
    # symlinks surviving the image boundary.
    rm -rf node_modules/@miladyai/agent; \
    mkdir -p node_modules/@miladyai/agent; \
    cp packages/agent/package.json node_modules/@miladyai/agent/; \
    cp -a packages/agent/src node_modules/@miladyai/agent/src; \
    mkdir -p node_modules/@miladyai/agent/dist; \
    cp -a packages/agent/dist/packages/agent/src/. node_modules/@miladyai/agent/dist/; \
    test -f node_modules/@miladyai/agent/dist/runtime/alice-capability-inventory.js; \
    test -f node_modules/@miladyai/agent/dist/runtime/alice-runtime-profile.js; \
    rm -rf node_modules/@rndrntwrk/plugin-555stream; \
    mkdir -p node_modules/@rndrntwrk/plugin-555stream; \
    cp packages/plugin-555stream/package.json node_modules/@rndrntwrk/plugin-555stream/; \
    cp -a packages/plugin-555stream/src node_modules/@rndrntwrk/plugin-555stream/src; \
    ls node_modules/@miladyai/agent/src/plugins/five55-games/index.ts node_modules/@rndrntwrk/plugin-555stream/src/index.ts >/dev/null; \
    # Materialize Milady's canonical app-core as real in-image bytes so the
    # capability BOM can hash it without following a workspace symlink.
    rm -rf node_modules/@miladyai/app-core node_modules/@elizaos/app-core; \
    mkdir -p node_modules/@miladyai/app-core; \
    cp packages/app-core/package.json node_modules/@miladyai/app-core/; \
    cp -a packages/app-core/src node_modules/@miladyai/app-core/src 2>/dev/null || true; \
    cp -a packages/app-core/dist node_modules/@miladyai/app-core/dist 2>/dev/null || true; \
    # The server imports @elizaos/app-core for compatibility. Point that name
    # at the same canonical, attested bytes without escaping node_modules.
    ln -s "../@miladyai/app-core" node_modules/@elizaos/app-core; \
    test "$(realpath node_modules/@elizaos/app-core)" = "$(realpath node_modules/@miladyai/app-core)"; \
    ls node_modules/@elizaos/app-core/src/index.ts 2>/dev/null && echo "@elizaos/app-core Milady alias OK" || echo "WARN: app-core Milady alias missing"; \
    # @elizaos/auth: the official orchestrator imports this leaf package at
    # module evaluation time, so preserve the exact pinned compiled package.
    rm -rf node_modules/@elizaos/auth; \
    mkdir -p node_modules/@elizaos/auth; \
    cp eliza/packages/auth/package.json node_modules/@elizaos/auth/; \
    cp -a eliza/packages/auth/dist node_modules/@elizaos/auth/dist; \
    ls node_modules/@elizaos/auth/dist/index.js 2>/dev/null && echo "@elizaos/auth dist OK" || echo "WARN: auth dist missing"; \
    # @elizaos/skills: agent-skills resolves both the compiled loader and the
    # bundled skill corpus from this exact pinned Eliza package.
    rm -rf node_modules/@elizaos/skills; \
    mkdir -p node_modules/@elizaos/skills; \
    cp eliza/packages/skills/package.json node_modules/@elizaos/skills/; \
    cp -a eliza/packages/skills/dist node_modules/@elizaos/skills/dist; \
    cp -a eliza/packages/skills/skills node_modules/@elizaos/skills/skills; \
    ls node_modules/@elizaos/skills/dist/index.js node_modules/@elizaos/skills/skills/elizaos/SKILL.md 2>/dev/null && echo "@elizaos/skills runtime OK" || echo "WARN: skills runtime missing"; \
    # These two providers are dynamically loaded by the current official
    # runtime. Materialize their compiled exports so the production image does
    # not depend on ignored workspace build output.
    rm -rf node_modules/@elizaos/plugin-local-inference; \
    mkdir -p node_modules/@elizaos/plugin-local-inference; \
    cp eliza/plugins/plugin-local-inference/package.json node_modules/@elizaos/plugin-local-inference/; \
    cp -a eliza/plugins/plugin-local-inference/dist node_modules/@elizaos/plugin-local-inference/dist; \
    ls node_modules/@elizaos/plugin-local-inference/dist/runtime/index.js 2>/dev/null && echo "@elizaos/plugin-local-inference runtime OK" || echo "WARN: local-inference runtime missing"; \
    rm -rf node_modules/@elizaos/plugin-openai; \
    mkdir -p node_modules/@elizaos/plugin-openai; \
    cp eliza/plugins/plugin-openai/package.json node_modules/@elizaos/plugin-openai/; \
    cp -a eliza/plugins/plugin-openai/dist node_modules/@elizaos/plugin-openai/dist; \
    ls node_modules/@elizaos/plugin-openai/dist/node/index.node.js 2>/dev/null && echo "@elizaos/plugin-openai runtime OK" || echo "WARN: OpenAI runtime missing"; \
    # plugin-elizacloud imports the exact pinned Cloud SDK from its compiled
    # Node entry. Keep that leaf package physical at the image boundary too.
    rm -rf node_modules/@elizaos/cloud-sdk; \
    mkdir -p node_modules/@elizaos/cloud-sdk; \
    cp eliza/packages/cloud/sdk/package.json node_modules/@elizaos/cloud-sdk/; \
    cp -a eliza/packages/cloud/sdk/dist node_modules/@elizaos/cloud-sdk/dist; \
    ls node_modules/@elizaos/cloud-sdk/dist/index.js 2>/dev/null && echo "@elizaos/cloud-sdk dist OK" || echo "WARN: Cloud SDK dist missing"; \
    # Latest official Alice imports the Eliza Cloud endpoint-config subpath at
    # module evaluation time even when a different provider owns inference.
    # Materialize the exact pinned build so that import cannot fall back to an
    # absent workspace dist directory in the production image.
    rm -rf node_modules/@elizaos/plugin-elizacloud; \
    mkdir -p node_modules/@elizaos/plugin-elizacloud; \
    cp eliza/plugins/plugin-elizacloud/package.json node_modules/@elizaos/plugin-elizacloud/; \
    cp -a eliza/plugins/plugin-elizacloud/dist node_modules/@elizaos/plugin-elizacloud/dist; \
    ls node_modules/@elizaos/plugin-elizacloud/dist/utils/config.js 2>/dev/null && echo "@elizaos/plugin-elizacloud endpoint config OK" || echo "WARN: Eliza Cloud endpoint config missing"; \
    # @elizaos/plugin-agent-orchestrator: Alice's compiled entry imports its
    # completion relay directly, so the official pinned Node bundle is part of
    # the cloud runtime rather than an optional desktop-only package.
    rm -rf node_modules/@elizaos/plugin-agent-orchestrator; \
    mkdir -p node_modules/@elizaos/plugin-agent-orchestrator; \
    cp eliza/plugins/plugin-agent-orchestrator/package.json node_modules/@elizaos/plugin-agent-orchestrator/; \
    cp -a eliza/plugins/plugin-agent-orchestrator/dist node_modules/@elizaos/plugin-agent-orchestrator/dist; \
    ls node_modules/@elizaos/plugin-agent-orchestrator/dist/node/index.node.js 2>/dev/null && echo "@elizaos/plugin-agent-orchestrator dist OK" || echo "WARN: agent-orchestrator dist missing"; \
    # @elizaos/plugin-form is a static import in Alice's runtime entry. The
    # official workspace package exports only compiled dist bytes, so replace
    # the workspace symlink with the exact build before the image is pruned.
    rm -rf node_modules/@elizaos/plugin-form; \
    mkdir -p node_modules/@elizaos/plugin-form; \
    cp eliza/plugins/plugin-form/package.json node_modules/@elizaos/plugin-form/; \
    cp -a eliza/plugins/plugin-form/dist node_modules/@elizaos/plugin-form/dist; \
    ls node_modules/@elizaos/plugin-form/dist/index.js 2>/dev/null && echo "@elizaos/plugin-form dist OK" || echo "WARN: form dist missing"; \
    # @elizaos/plugin-commands: Alice's compiled entry imports the real package
    # from the exact reviewed Eliza pin. Never substitute a stub or npm bytes.
    rm -rf node_modules/@elizaos/plugin-commands; \
    mkdir -p node_modules/@elizaos/plugin-commands; \
    cp eliza/plugins/plugin-commands/package.json node_modules/@elizaos/plugin-commands/; \
    cp -a eliza/plugins/plugin-commands/dist node_modules/@elizaos/plugin-commands/dist; \
    ls node_modules/@elizaos/plugin-commands/dist/index.js 2>/dev/null && echo "@elizaos/plugin-commands dist OK" || echo "WARN: commands dist missing"; \
    # @elizaos/plugin-sql: the current official package exports its Node build
    # from src/dist, which is ignored source output unless CI builds and copies
    # it into the materialized runtime package explicitly.
    rm -rf node_modules/@elizaos/plugin-sql; \
    mkdir -p node_modules/@elizaos/plugin-sql/src; \
    cp eliza/plugins/plugin-sql/package.json node_modules/@elizaos/plugin-sql/; \
    cp -a eliza/plugins/plugin-sql/src/dist node_modules/@elizaos/plugin-sql/src/dist; \
    ls node_modules/@elizaos/plugin-sql/src/dist/node/index.node.js 2>/dev/null && echo "@elizaos/plugin-sql dist OK" || echo "WARN: SQL dist missing"; \
    # @elizaos/plugin-app-control: Alice's agent bundle imports this official
    # runtime plugin even when the reduced image install does not hoist it.
    rm -rf node_modules/@elizaos/plugin-app-control; \
    mkdir -p node_modules/@elizaos/plugin-app-control; \
    cp eliza/plugins/plugin-app-control/package.json node_modules/@elizaos/plugin-app-control/; \
    cp -a eliza/plugins/plugin-app-control/dist node_modules/@elizaos/plugin-app-control/dist; \
    ls node_modules/@elizaos/plugin-app-control/dist/index.js 2>/dev/null && echo "@elizaos/plugin-app-control dist OK" || echo "WARN: app-control dist missing"; \
    # The remaining official plugins are also static imports in Alice's entry.
    rm -rf node_modules/@elizaos/plugin-app-manager; \
    mkdir -p node_modules/@elizaos/plugin-app-manager; \
    cp eliza/plugins/plugin-app-manager/package.json node_modules/@elizaos/plugin-app-manager/; \
    cp -a eliza/plugins/plugin-app-manager/dist node_modules/@elizaos/plugin-app-manager/dist; \
    ls node_modules/@elizaos/plugin-app-manager/dist/index.js 2>/dev/null && echo "@elizaos/plugin-app-manager dist OK" || echo "WARN: app-manager dist missing"; \
    rm -rf node_modules/@elizaos/plugin-scheduling; \
    mkdir -p node_modules/@elizaos/plugin-scheduling; \
    cp eliza/plugins/plugin-scheduling/package.json node_modules/@elizaos/plugin-scheduling/; \
    cp -a eliza/plugins/plugin-scheduling/dist node_modules/@elizaos/plugin-scheduling/dist; \
    ls node_modules/@elizaos/plugin-scheduling/dist/index.js 2>/dev/null && echo "@elizaos/plugin-scheduling dist OK" || echo "WARN: scheduling dist missing"; \
    rm -rf node_modules/@elizaos/plugin-wallet; \
    mkdir -p node_modules/@elizaos/plugin-wallet; \
    cp eliza/plugins/plugin-wallet/package.json node_modules/@elizaos/plugin-wallet/; \
    cp -a eliza/plugins/plugin-wallet/dist node_modules/@elizaos/plugin-wallet/dist; \
    ls node_modules/@elizaos/plugin-wallet/dist/index.mjs node_modules/@elizaos/plugin-wallet/dist/diagnostic.js 2>/dev/null && echo "@elizaos/plugin-wallet dist OK" || echo "WARN: wallet dist missing"; \
    # @elizaos/vault: app-core/agent source imports must resolve under tsx.
    rm -rf node_modules/@elizaos/vault; \
    mkdir -p node_modules/@elizaos/vault; \
    cp eliza/packages/vault/package.json node_modules/@elizaos/vault/; \
    cp -a eliza/packages/vault/src node_modules/@elizaos/vault/src 2>/dev/null || true; \
    cp -a eliza/packages/vault/dist node_modules/@elizaos/vault/dist 2>/dev/null || true; \
    ls node_modules/@elizaos/vault/src/index.ts 2>/dev/null && echo "@elizaos/vault src OK" || echo "WARN: @elizaos/vault src missing"; \
    # @miladyai/shared: app-core and agent source imports must resolve at runtime.
    rm -rf node_modules/@miladyai/shared; \
    mkdir -p node_modules/@miladyai/shared; \
    cp packages/shared/package.json node_modules/@miladyai/shared/; \
    cp -a packages/shared/src node_modules/@miladyai/shared/src 2>/dev/null || true; \
    cp -a packages/shared/dist node_modules/@miladyai/shared/dist 2>/dev/null || true; \
    ls node_modules/@miladyai/shared/src/index.ts 2>/dev/null && echo "@miladyai/shared src OK" || echo "WARN: @miladyai/shared src missing"; \
    mkdir -p node_modules/@mariozechner; \
    pi_ai_store="$(find node_modules/.bun -path "*/node_modules/@mariozechner/pi-ai" -type d | head -n 1)"; \
    test -n "$pi_ai_store"; \
    rm -rf node_modules/@mariozechner/pi-ai; \
    ln -s "../${pi_ai_store#node_modules/}" node_modules/@mariozechner/pi-ai; \
    ls node_modules/@mariozechner/pi-ai/package.json 2>/dev/null && echo "@mariozechner/pi-ai root link OK" || echo "WARN: @mariozechner/pi-ai root link missing"; \
    # @elizaos/shared: DON'T replace — the npm version or resolved workspace symlink works.
    # Workspace package.json exports point to ./src/*.ts (tsx handles this).
    # Replacing with dist-only breaks resolution since exports don't match dist layout.
    true
# Link any remaining missing workspace app packages to node_modules
RUN for app_dir in eliza/apps/app-coding eliza/apps/app-shopify; do \
      if [ -d "$app_dir" ]; then \
        PKG_NAME=$(node -p "require('./${app_dir}/package.json').name" 2>/dev/null); \
        if [ -n "$PKG_NAME" ] && [ ! -e "node_modules/$PKG_NAME" ]; then \
          mkdir -p "node_modules/$(dirname $PKG_NAME)"; \
          ln -s "../../$app_dir" "node_modules/$PKG_NAME"; \
          echo "Linked: $PKG_NAME -> $app_dir"; \
        fi; \
      fi; \
    done
# Remove broken nested @elizaos/core entries in eliza subdirs.
# bun creates workspace symlinks like eliza/apps/app-lifeops/node_modules/@elizaos/core
# that resolve correctly in CI but point nowhere in Docker. Removing them forces
# Node's module resolution to walk up to root node_modules/@elizaos/core instead.
RUN find eliza packages -path '*/node_modules/@elizaos/core' -not -path '*/node_modules/.bun/*' \
    | while read p; do rm -rf "$p" && echo "Removed nested: $p"; done; true
RUN find eliza packages -path '*/node_modules/@elizaos/agent' -not -path '*/node_modules/.bun/*' \
    | while read p; do rm -rf "$p" && echo "Removed nested: $p"; done; true

# ===== End symlink replacement =====

# Delete raw TypeScript source from eliza workspace packages.
# tsx prefers .ts over compiled .js, causing cascading dep resolution failures.
# eliza/packages/core/src is kept because tsx resolves @elizaos/core imports via
# tsconfig paths that point here (e.g. @elizaos/core/utils/context-catalog). Removing it
# breaks agent startup even though the compiled dist is also present.

# Patch @noble/ciphers: add extensionless export aliases (./aes, ./chacha, etc.)
# crypto-compat.ts imports '@noble/ciphers/aes' but the package only exports './aes.js'.
# Same pattern as the @noble/hashes patch in patch-deps.mjs.
RUN node - <<'__NOBLE_PATCH__'
const fs = require('fs');
const path = require('path');
function patchExtensionlessExports(dir) {
  const pkgPath = path.join(dir, 'package.json');
  if (!fs.existsSync(pkgPath)) return;
  const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'));
  if (!pkg.exports) return;
  let changed = false;
  const entries = Object.entries(pkg.exports);
  for (const [key, val] of entries) {
    if (key.endsWith('.js')) {
      const stripped = key.slice(0, -3);
      if (!pkg.exports[stripped]) {
        pkg.exports[stripped] = val;
        changed = true;
      }
    }
  }
  if (changed) {
    fs.writeFileSync(pkgPath, JSON.stringify(pkg, null, 2));
    console.log('[patch-deps] Patched ' + pkg.name + ' exports: added extensionless aliases.');
  }
}
patchExtensionlessExports('node_modules/@noble/ciphers');
patchExtensionlessExports('node_modules/@noble/curves');
__NOBLE_PATCH__

# Fix dist layout: package.json says dist/index.node.js but build creates dist/node/index.node.js
RUN CORE_DIR="node_modules/@elizaos/core"; \
    if [ -f "$CORE_DIR/dist/node/index.node.js" ] && [ ! -f "$CORE_DIR/dist/index.node.js" ]; then \
      ln -s node/index.node.js "$CORE_DIR/dist/index.node.js"; \
      echo "Linked dist/index.node.js -> dist/node/index.node.js"; \
    fi; \
    if [ -f "$CORE_DIR/dist/browser/index.browser.js" ] && [ ! -f "$CORE_DIR/dist/index.browser.js" ]; then \
      ln -s browser/index.browser.js "$CORE_DIR/dist/index.browser.js"; \
    fi

# Hoist missing deps from workspace packages to top-level node_modules
# tsx resolves raw .ts source which imports packages not hoisted by bun
RUN for pkg_dir in eliza/packages/core eliza/packages/shared eliza/packages/agent eliza/apps/app-companion eliza/apps/app-lifeops; do \
      if [ -d "$pkg_dir/node_modules" ]; then \
        for dep in $(ls "$pkg_dir/node_modules/" 2>/dev/null | grep -v '^\.'); do \
          if [ ! -e "node_modules/$dep" ] && [ -d "$pkg_dir/node_modules/$dep" ]; then \
            cp -a "$pkg_dir/node_modules/$dep" "node_modules/$dep"; \
            echo "Hoisted: $dep"; \
          fi; \
        done; \
        for scope in $(ls "$pkg_dir/node_modules/@"* 2>/dev/null -d | xargs -I{} basename {}); do \
          if [ -d "$pkg_dir/node_modules/@$scope" ]; then \
            mkdir -p "node_modules/@$scope"; \
            for dep in $(ls "$pkg_dir/node_modules/@$scope/" 2>/dev/null); do \
              if [ ! -e "node_modules/@$scope/$dep" ]; then \
                cp -a "$pkg_dir/node_modules/@$scope/$dep" "node_modules/@$scope/$dep"; \
                echo "Hoisted: @$scope/$dep"; \
              fi; \
            done; \
          fi; \
        done; \
      fi; \
    done

# Hoist packages from node_modules/.bun/ to node_modules/.
# bun resolves packages and stores them in .bun/ but when workspace:* entries
# have empty plugin dirs, the hoisting symlinks are never created. Copy them.
RUN node - <<'__HOIST__'
const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

// isAccessible: follows symlinks, returns false for broken symlinks
function isAccessible(p) { return fs.existsSync(p); }
// symlinkExists: uses lstatSync, returns true even for broken symlinks
function symlinkExists(p) { try { fs.lstatSync(p); return true; } catch(e) { return false; } }
// ensureDst: removes broken symlinks so cp -r can proceed cleanly
function ensureDst(dst) {
  if (isAccessible(dst)) return false; // real dir/file exists, skip
  if (symlinkExists(dst)) fs.unlinkSync(dst); // delete broken symlink
  return true; // proceed with copy
}

// --- Phase 1: Hoist .bun/ -> node_modules/ ---
// bun stores packages in .bun/<name@ver>/node_modules/<scope>/<pkg>/ but
// doesn't create root-level node_modules symlinks when workspace:* entries
// have empty plugin dirs. Also, bun may create broken relative symlinks for
// packages in the CI workspace that don't resolve inside Docker. Replace both.
const bunDir = 'node_modules/.bun';
let hoisted = 0;
if (fs.existsSync(bunDir)) {
  for (const entry of fs.readdirSync(bunDir)) {
    const nmPath = path.join(bunDir, entry, 'node_modules');
    if (!fs.existsSync(nmPath)) continue;
    for (const pkg of fs.readdirSync(nmPath)) {
      if (pkg.startsWith('@')) {
        const scopeDir = path.join(nmPath, pkg);
        try { if (!fs.statSync(scopeDir).isDirectory()) continue; } catch(e) { continue; }
        fs.mkdirSync(path.join('node_modules', pkg), {recursive:true});
        for (const sub of fs.readdirSync(scopeDir)) {
          const src = path.join(scopeDir, sub);
          const dst = path.join('node_modules', pkg, sub);
          try {
            if (ensureDst(dst) && fs.statSync(src).isDirectory()) {
              execSync('cp -r "' + src + '" "' + dst + '"');
              hoisted++;
            }
          } catch(e) { /* skip broken .bun entries */ }
        }
      } else {
        const src = path.join(nmPath, pkg);
        const dst = path.join('node_modules', pkg);
        try {
          if (ensureDst(dst) && fs.statSync(src).isDirectory()) {
            execSync('cp -r "' + src + '" "' + dst + '"');
            hoisted++;
          }
        } catch(e) { /* skip */ }
      }
    }
  }
}
console.log('Phase 1: hoisted ' + hoisted + ' packages from .bun/');

// Phase 1's broad fallback is intentionally permissive, but filesystem order
// must never decide the version of a package that the root runtime imports.
// Re-materialize those packages from the exact version selected by bun.lock.
const rootLock = fs.readFileSync('bun.lock', 'utf8');
function rootLockedVersion(name) {
  const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const match = rootLock.match(new RegExp(
    '^    "' + escaped + '": \\["' + escaped + '@([^"+]+)(?:\\+[^" ]+)?"',
    'm',
  ));
  if (!match) throw new Error('root locked package missing from bun.lock: ' + name);
  return match[1];
}
function materializeRootLockedPackage(name) {
  const version = rootLockedVersion(name);
  const candidates = [];
  for (const entry of fs.readdirSync(bunDir).sort()) {
    const src = path.join(bunDir, entry, 'node_modules', name);
    const packageJson = path.join(src, 'package.json');
    if (!fs.existsSync(packageJson)) continue;
    const candidateVersion = JSON.parse(fs.readFileSync(packageJson, 'utf8')).version;
    if (candidateVersion === version) candidates.push(src);
  }
  if (candidates.length === 0) {
    throw new Error('root locked package bytes missing from .bun: ' + name + '@' + version);
  }
  const dst = path.join('node_modules', name);
  fs.rmSync(dst, { recursive: true, force: true });
  fs.mkdirSync(path.dirname(dst), { recursive: true });
  fs.cpSync(candidates[0], dst, { recursive: true });
  const installedVersion = JSON.parse(
    fs.readFileSync(path.join(dst, 'package.json'), 'utf8'),
  ).version;
  if (installedVersion !== version) {
    throw new Error('root locked package version mismatch: ' + name);
  }
  console.log('root locked package materialized: ' + name + '@' + version);
}
materializeRootLockedPackage('viem');
materializeRootLockedPackage('@scure/bip39');

const requiredLockedPackages = [
  '@elizaos/auth',
  '@elizaos/skills',
  '@elizaos/plugin-agent-orchestrator',
  '@elizaos/plugin-agent-skills',
  '@elizaos/plugin-form',
  '@elizaos/plugin-anthropic',
  '@elizaos/plugin-local-inference',
  '@elizaos/plugin-openai',
  '@elizaos/plugin-elizacloud',
  '@elizaos/cloud-sdk',
  '@elizaos/plugin-commands',
  '@elizaos/plugin-sql',
  '@elizaos/plugin-app-control',
  '@elizaos/plugin-app-manager',
  '@elizaos/plugin-local-embedding',
  '@elizaos/plugin-scheduling',
  '@elizaos/plugin-wallet',
  'viem',
  '@scure/bip39',
];
for (const name of requiredLockedPackages) {
  const packageJson = path.join('node_modules', name, 'package.json');
  if (!fs.existsSync(packageJson)) {
    throw new Error('locked runtime package missing after hoist: ' + name);
  }
  const version = JSON.parse(fs.readFileSync(packageJson, 'utf8')).version;
  console.log('locked runtime package present: ' + name + '@' + version);
}
__HOIST__

ARG VERSION_CLEAN

# Patch autonomous version
RUN if [ -n "${VERSION_CLEAN}" ]; then \
  node -e " \
  const fs = require('fs'); \
  const v = '${VERSION_CLEAN}'; \
  try { \
  const p = JSON.parse(fs.readFileSync('node_modules/@elizaos/agent/package.json', 'utf8')); \
  p.version = v; \
  fs.writeFileSync('node_modules/@elizaos/agent/package.json', JSON.stringify(p, null, 2)); \
  console.log('Patched autonomous to', v); \
  } catch(e) { console.log('skip:', e.message); } \
  "; \
  fi

# Remove implementations that the checked capability policy delegates or classifies as non-Linux.
RUN rm -rf \
  node_modules/@huggingface/transformers \
  node_modules/@huggingface/tokenizers \
  node_modules/@elizaos/native-activity-tracker \
  node_modules/@elizaos/plugin-cron \
  node_modules/@elizaos/plugin-local-embedding \
  node_modules/@elizaos/plugin-todo \
  node_modules/onnxruntime-common \
  node_modules/onnxruntime-node \
  node_modules/onnxruntime-web

# Fix @ai-sdk/provider-utils version conflict:
# @ai-sdk/google@3.x needs provider-utils@4.x (exports convertToBase64),
# but bun hoisted provider-utils@2.x to top-level. Replace with the 4.x copy.
RUN node - <<'__AISDK_FIX__'
const fs = require('fs');
const path = require('path');
const bunDir = 'node_modules/.bun';
const target = 'node_modules/@ai-sdk/provider-utils';
if (fs.existsSync(bunDir)) {
  const entries = fs.readdirSync(bunDir).filter(e => e.startsWith('@ai-sdk+provider-utils@4.'));
  if (entries.length > 0) {
    // Pick the latest 4.x
    entries.sort();
    const src = path.join(bunDir, entries[entries.length - 1], 'node_modules/@ai-sdk/provider-utils');
    if (fs.existsSync(src)) {
      fs.rmSync(target, { recursive: true, force: true });
      fs.cpSync(src, target, { recursive: true });
      const ver = JSON.parse(fs.readFileSync(path.join(target, 'package.json'), 'utf8')).version;
      console.log('Upgraded @ai-sdk/provider-utils to ' + ver);
    }
  }
}
__AISDK_FIX__

# Bun keeps reviewed workspace packages as links back into the source checkout.
# Convert only exact policy packages whose root lock record names that exact
# workspace into physical node_modules bytes before the strict capability BOM.
RUN node deploy/modal/alice_capability_bom.mjs --materialize-policy-workspaces

# Fail during image assembly—not after a multi-minute pull—if latest official
# app-manager cannot evaluate against Alice's @elizaos/agent compatibility host.
RUN node --import ./node_modules/tsx/dist/loader.mjs --input-type=module \
  -e "const fs = await import('node:fs'); await import('@scure/bip39/wordlists/portuguese'); const skills = await import('@elizaos/skills'); await import('@elizaos/plugin-local-inference/runtime'); await import('@elizaos/plugin-openai'); await import('@elizaos/plugin-elizacloud/endpoint-config'); await import('@elizaos/plugin-elizacloud'); await Promise.all([import('@elizaos/plugin-app-manager'), import('@elizaos/plugin-agent-orchestrator'), import('@elizaos/plugin-commands'), import('@elizaos/plugin-form'), import('@elizaos/plugin-sql')]); if (!fs.existsSync(skills.getSkillsDir())) throw new Error('@elizaos/skills corpus missing')"

# Safe pruning only (GPU binaries + obvious dead weight)
RUN rm -rf \
  node_modules/.bun/@node-llama-cpp+linux-x64-cuda-ext@* \
  node_modules/.bun/@node-llama-cpp+linux-x64-cuda@* \
  node_modules/.bun/@node-llama-cpp+linux-x64-vulkan@* \
  node_modules/.bun/@node-llama-cpp+linux-arm64@* \
  node_modules/.bun/@node-llama-cpp+linux-armv7l@* \
  node_modules/@storybook \
  node_modules/storybook \
  apps/app/public \
  2>/dev/null || true

# Remove source maps and test dirs
RUN find node_modules -name '*.map' -delete 2>/dev/null; \
  find node_modules -type d -name '__tests__' -exec rm -rf {} + 2>/dev/null; \
  find node_modules -type d -name 'test' -maxdepth 3 -exec rm -rf {} + 2>/dev/null; \
  true

FROM node:24.19.0-bookworm-slim@sha256:65932751ed4073ed02f5c04e494e4b2572a891b7dbea0568a863dc80341bf848
ARG ESBUILD_VERSION
ARG APP_ENTRYPOINT
ARG APP_CMD_START
ARG APP_PORT
ARG APP_API_BIND
ARG OCI_SOURCE
ARG OCI_TITLE
ARG OCI_DESCRIPTION
ARG OCI_LICENSES
ARG VERSION
ARG VERSION_CLEAN
ARG REVISION
ARG ELIZA_REVISION
LABEL org.opencontainers.image.title="${OCI_TITLE}" \
      org.opencontainers.image.description="${OCI_DESCRIPTION}" \
      org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.url="${OCI_SOURCE}" \
      org.opencontainers.image.version="${VERSION_CLEAN}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="${OCI_LICENSES}"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg libopus-dev \
  && rm -rf /var/lib/apt/lists/*
COPY --from=python-runtime /usr/local /usr/local
WORKDIR /app
COPY --from=pruner /app /app
RUN node deploy/modal/alice_capability_bom.mjs \
  && ALICE_CAPABILITY_BOM_SHA256="$(node --input-type=module -e 'import fs from "node:fs"; import crypto from "node:crypto"; const bytes = fs.readFileSync("alice-capability-bom.json"); process.stdout.write(`sha256:${crypto.createHash("sha256").update(bytes).digest("hex")}`);')" \
  REVISION="${REVISION}" ELIZA_REVISION="${ELIZA_REVISION}" \
  node deploy/modal/write_alice_runtime_build_manifest.mjs

# NOTE: Do NOT install esbuild globally. tsx bundles its own esbuild.
# A global esbuild binary causes a recursive fork bomb (8000+ processes)
# when tsx's loader spawns esbuild service processes.

ENV NODE_ENV=production
ENV ELIZA_DISABLE_EDGE_TTS=1
ENV APP_ENTRYPOINT=${APP_ENTRYPOINT}
ENV APP_CMD_START=${APP_CMD_START}
ENV APP_PORT=${APP_PORT}
ENV APP_API_BIND=${APP_API_BIND}
ENV ELIZA_PORT=${APP_PORT}
ENV ELIZA_API_BIND=${APP_API_BIND}
# Bake the cloud image version so the version-resolver picks it up at runtime
# (takes priority over package.json patching which can be fragile)
ENV ELIZA_BUNDLED_VERSION=${VERSION_CLEAN}
ENV ELIZA_ALLOWED_HOSTS=*
EXPOSE ${APP_PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD sh -lc 'port="${PORT:-${APP_PORT:-${ELIZA_PORT:-2138}}}"; code="$(curl -s -o /dev/null -w "%{http_code}" "http://127.0.0.1:${port}/health/live")" && [ "$code" = "200" ]'

ENTRYPOINT ["sh", "./eliza/packages/app-core/scripts/docker-entrypoint.sh"]
CMD ["sh", "-lc", "exec ${APP_CMD_START:-node --import ./node_modules/tsx/dist/loader.mjs ${APP_ENTRYPOINT} start}"]
